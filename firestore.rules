rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'platform_super_admin' ||
        request.auth.token.role == 'platform_admin' ||
        request.auth.token.email == 'davmuchiri48@gmail.com' ||
        exists(/databases/{database}/documents/platform_users/$(request.auth.uid))
      );
    }

    // Platform level users
    match /platform_users/{userId} {
      allow read, write: if true;
    }

    // Platform settings & subscriptions
    match /platform_settings/{settingId} {
      allow read, write: if true;
    }

    // Platform wide audit logs
    match /platform_audit_logs/{logId} {
      allow read, write: if true;
    }

    // Public contact inquiries collection
    match /public_inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Tenants top-level collection & all nested subcollections (students, staff, classes, finance, attendance, etc.)
    match /tenants/{tenantId} {
      allow read, write: if true;

      // Subcollections inside a tenant - isolated per tenant
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
  }
}

